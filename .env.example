# Copy to .env to override. Every value here is already the built-in default, so the stack comes
# up correctly with no .env at all — this file exists so that the credentials have one place to
# change rather than three.
#
# Compose reads .env itself for ${VAR} interpolation; it is not passed into containers wholesale.
# Only the variables referenced in docker-compose.yml reach a service.

# Object storage (P5 export packages). These three must agree: MINIO_ROOT_USER/PASSWORD create the
# credential inside MinIO, minio-init uses it to create the buckets, and export-service uses it to
# read and write them. Changing the pair here changes all three.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Endpoint as seen from inside the compose network. Running export-service from a jar on the host
# instead? That service defaults to http://localhost:9000 on its own; leave this alone.
MINIO_ENDPOINT=http://minio:9000


# ---------------------------------------------------------------- real AWS S3 (optional)
#
# Uncomment to point export-service at a real bucket instead of the local minio container.
# Nothing else moves: P2's archive lives in MongoDB and Postgres, so this only affects where
# export packages are written and read.
#
# One bucket is the expected shape. Set both bucket variables to the same bucket and let the two
# prefixes separate the halves — the split is what guarantees a failed export leaves nothing
# downloadable (FR-6.6), so it survives the move to a single bucket. Giving both the same
# bucket *and* the same prefix is refused at startup, because promote() would then copy each
# package onto itself and delete it.
#
# Credentials are a static key pair by design: the MinIO SDK does not implement the AWS default
# provider chain, so IAM roles, SSO and ~/.aws/credentials are not consulted. Use an IAM user
# scoped to this bucket alone, with s3:GetObject, s3:PutObject and s3:DeleteObject — delete is
# required because promoting a package copies it and then removes the staging copy.
#
# S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# S3_REGION=eu-west-1
# S3_ACCESS_KEY=AKIA...
# S3_SECRET_KEY=...
# S3_STAGING_BUCKET=your-existing-bucket
# S3_PACKAGES_BUCKET=your-existing-bucket
# S3_STAGING_PREFIX=exports/staging/
# S3_PACKAGES_PREFIX=exports/packages/
