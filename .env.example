# Copy to .env to override. Every value here is already the built-in default, so the stack comes
# up correctly with no .env at all — this file exists so that the credentials have one place to
# change rather than three.
#
# Compose reads .env itself for ${VAR} interpolation; it is not passed into containers wholesale.
# Only the variables referenced in docker-compose.yml reach a service.

# Object storage (P5 export packages). These three must agree: MINIO_ROOT_USER/PASSWORD create the
# credential inside MinIO, minio-init uses it to create the buckets, and export-service uses it to
# read and write them. Changing the pair here changes all three.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Endpoint as seen from inside the compose network. Running export-service from a jar on the host
# instead? That service defaults to http://localhost:9000 on its own; leave this alone.
MINIO_ENDPOINT=http://minio:9000
